
# Checksummed catalog/index/audit bytes must survive Windows checkouts.
instruments/*.json text eol=lf
instruments/**/*.json text eol=lf
# Transfer-owned documentation must hash identically on Windows and Linux.
instruments/fluidr3-percussion/README.md text eol=lf
# Preserve upstream notices byte-for-byte for their pinned source hashes.
instruments/fluidr3-gm/upstream/* -text

# Preserve pinned upstream whitespace as well as original bytes.
instruments/fluidr3-percussion/upstream/* -text -whitespace

# Environment originals retain exact download bytes and source checksums.
models/**/source/** -text -diff

# Construction pins hash the exact asset-record bytes; keep them stable across
# Windows/Linux checkouts, including reviewed conversion JSON sidecars.
models/**/asset.json text eol=lf
models/catalog.json text eol=lf
models/**/working/*.json text eol=lf
